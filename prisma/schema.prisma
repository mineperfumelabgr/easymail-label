// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

// Note that some adapters may set a maximum length for the String type by default, please ensure your strings are long
// enough when changing adapters.
// See https://www.prisma.io/docs/orm/reference/prisma-schema-reference#string for more information

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Session {
  id                  String    @id
  shop                String
  state               String
  isOnline            Boolean   @default(false)
  scope               String?
  expires             DateTime?
  accessToken         String
  userId              BigInt?
  firstName           String?
  lastName            String?
  email               String?
  accountOwner        Boolean   @default(false)
  locale              String?
  collaborator        Boolean?  @default(false)
  emailVerified       Boolean?  @default(false)
  refreshToken        String?
  refreshTokenExpires DateTime?
}

model EasymailVoucher {
  id             String   @id @default(cuid())
  shop           String
  orderId        String // gid://shopify/Order/...
  orderName      String?
  shipmentNumber String
  createdAt      DateTime @default(now())

  @@unique([shop, orderId])
  @@index([shop, createdAt])
}

model Employee {
  id             String   @id @default(cuid())
  shop           String
  name           String
  normalizedName String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([shop, normalizedName])
  @@index([shop, name])
}

model AcsTrackingSnapshot {
  id             String   @id @default(cuid())
  shop           String
  orderId        String?
  orderName      String?
  orderCreatedAt DateTime?
  fulfillmentId  String?
  fulfillmentStatus String?
  fulfillmentCreatedAt DateTime?
  fulfillmentDeliveredAt DateTime?
  voucherNo      String
  recipientName  String?
  customerId     String?
  customerName   String?
  customerEmail  String?
  orderSourceName String?
  recipientPhone String?
  addressPreview String?
  country        String?
  status         String
  statusLabel    String
  shipmentStatus Int?
  deliveryFlag   Int?
  returnedFlag   Int?
  reasonCode     String?
  lastCheckpoint String?
  lastLocation   String?
  lastEventAt    DateTime?
  lastShopifyEventStatus String?
  lastShopifyCheckpointAt DateTime?
  lastCheckedAt  DateTime @default(now())
  error          String?
  completedAt DateTime?
  trackingDetailsPurgedAt DateTime?

  @@unique([shop, voucherNo])
  @@index([shop, status, lastCheckedAt])
  @@index([shop, orderName])
  @@index([shop, recipientName])
  @@index([shop, trackingDetailsPurgedAt, completedAt], map: "acs_tracking_retention_idx")
}

model AcsTrackingTagRule {
  id        String   @id @default(cuid())
  shop      String
  status    String
  enabled   Boolean  @default(false)
  tag       String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([shop, status])
  @@index([shop])
}

model AcsManualShipment {
  id             String   @id @default(cuid())
  shop           String
  recipientName  String
  phone          String
  email          String?
  company        String?
  address        String
  floor          String?
  city           String
  region         String
  zip            String
  countryCode    String
  pieces         Int      @default(1)
  codAmount      Float?
  pickupDate     String
  reference      String?
  voucherNo      String
  shipmentNumbers String
  createdAt      DateTime @default(now())

  @@unique([shop, voucherNo])
  @@index([shop, createdAt])
}

model CourierRule {
  shop String
  country String
  carrier String
  @@id([shop, country])
}

model CourierShipment {
  id String @id @default(cuid())
  shop String
  orderId String
  orderName String
  country String
  carrier String
  environment String
  reference String @unique
  jobId String?
  voucher String?
  labels Json?
  genikiTerminalSynced Boolean @default(false)
  checkedAt DateTime?
  sourceOrderId String?
  returnPending Boolean @default(false)
  returnSerial String?
  previousId String? @unique
  weight Float?
  codAmount Float?
  recipientName String?
  customerId String?
  customerName String?
  customerEmail String?
  orderSourceName String?
  recipientPhone String?
  addressPreview String?
  preparedBy String?
  pieces Int?
  fulfillmentPlan Json?
  status String @default("Creating")
  fulfillmentId String?
  createdAt DateTime @default(now())
  completedAt DateTime?
  trackingDetailsPurgedAt DateTime?
  @@unique([shop, orderId, environment])
  @@index([shop, carrier, createdAt])
  @@index([shop, trackingDetailsPurgedAt, completedAt], map: "courier_tracking_retention_idx")
}

model GenikiTagRule {
  shop String
  status String
  tag String
  @@id([shop,status])
}

model GenikiDailyHandover {
  shop String
  date String
  environment String
  finalizedAt DateTime
  confirmations Int @default(1)
  @@id([shop, date, environment])
}
